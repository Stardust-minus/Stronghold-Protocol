FROM node@sha256:7fddd9ddeae8196abf4a3ef2de34e11f7b1a722119f91f28ddf1e99dcafdf114
ARG SOURCE_REVISION
ARG APP_VERSION
LABEL org.opencontainers.image.source="https://github.com/Stardust-minus/Stronghold-Protocol" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.version="${APP_VERSION}"
RUN test -n "${SOURCE_REVISION}" && test -n "${APP_VERSION}"
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000 SP_COMBAT=server SP_VERIFY=off TRUST_PROXY=auto
WORKDIR /app
COPY app/ /app/
# Offline app exports must retain the same tiny canonical policy/data/license as the auth image.
# Fail the build immediately if an older export omitted the deploy/stardust/auth moderation files.
RUN for file in name-policy.mjs name-dictionary.mjs name-sensitive-dictionary.mjs \
      name-filter-vendor.mjs name-filter-node.mjs NAME-DICTIONARY-LICENSE.txt \
      NAME-FILTER-LICENSE.txt NAME-CATEGORIES-LICENSE.txt NAME-POLITICAL-LICENSE.txt; do \
      test -s "deploy/stardust/auth/$file" || exit 1; \
    done \
 && node --input-type=module -e "import { moderateName } from './shared/names.js'; import { NAME_FILTER_SOURCE } from './deploy/stardust/auth/name-filter-vendor.mjs'; if (NAME_FILTER_SOURCE.version !== '4.0.3' || !moderateName('阿米娅').ok) process.exit(1)"
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD wget -q -O /dev/null "http://127.0.0.1:${PORT}/healthz" || exit 1
CMD ["node", "server/index.js"]
