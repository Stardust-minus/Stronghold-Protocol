FROM node@sha256:7fddd9ddeae8196abf4a3ef2de34e11f7b1a722119f91f28ddf1e99dcafdf114
ARG SOURCE_REVISION
ARG APP_VERSION
LABEL org.opencontainers.image.source="https://github.com/Stardust-minus/Stronghold-Protocol" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.version="${APP_VERSION}"
RUN test -n "${SOURCE_REVISION}" && test -n "${APP_VERSION}"
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000 SP_COMBAT=server SP_VERIFY=off TRUST_PROXY=auto
WORKDIR /app
COPY app/ /app/
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD wget -q -O /dev/null "http://127.0.0.1:${PORT}/healthz" || exit 1
CMD ["node", "server/index.js"]
