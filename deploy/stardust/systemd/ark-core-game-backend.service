# Host-only policy: installation/enable requires explicit authorization; never restart a live game implicitly.
[Unit]
Description=Ark Hangzhou core game backend and scoped WG lease
After=docker.service ark-wireguard-route.service
Requires=docker.service ark-wireguard-route.service
ConditionPathExists=/sys/class/net/ark-wg-test
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
Nice=0
ExecStart=/usr/bin/python3 -B /opt/ark-proto/main-priority/current/game-backend-manager.py --profile core --config /opt/ark-proto/main-priority/config.json --action serve
ExecStopPost=/usr/bin/python3 -B /opt/ark-proto/main-priority/current/game-backend-manager.py --profile core --config /opt/ark-proto/main-priority/config.json --action stop
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=multi-user.target
